FROM docker.io/library/ubuntu@sha256:e5a4d6262ab5dbc25a85e60550dd7c87fd41a74fe43881534ed8288b2a7a3f8d

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    bash ca-certificates curl git openssh-server python3 nodejs npm ripgrep \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --global @openai/codex@0.154.0
COPY --from=ghcr.io/astral-sh/uv@sha256:0d127b3a7049b879a6e18a79c7f33fea59aa83c226464248f89cfb716a6b96f5 /uv /uvx /usr/local/bin/
ENV UV_PYTHON_INSTALL_DIR=/opt/python
RUN uv python install 3.11.15 --no-bin \
    && ln -s "$(uv python find 3.11.15)" /usr/local/bin/python3.11
RUN useradd --uid 10001 --create-home --shell /bin/bash worker \
    && passwd -d worker \
    && mkdir -p /run/sshd /workspace /run/worker \
    && chown 10001:10001 /workspace /run/worker

COPY sshd_config /etc/ssh/worker_sshd_config
COPY git_transfer.py /opt/symphony/git_transfer.py
USER 10001:10001
WORKDIR /workspace
ENV HOME=/home/worker
ENTRYPOINT ["/usr/sbin/sshd", "-D", "-e", "-f", "/etc/ssh/worker_sshd_config"]
